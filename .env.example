# 复制本文件为 .env 并填入真实值。 .env 不会进 git。
# Tushare Pro token (你已获取): https://tushare.pro/user/token
TUSHARE_TOKEN=在这里粘贴你的_tushare_token

# 可选：Home 页「AI 总结」默认使用 DeepSeek；不要把真实 key 提交到 git。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# 总结/解释默认关闭思考模式，更快更便宜；需要深推理时可改为 enabled。
DEEPSEEK_THINKING=disabled

# 可选：ChatGPT 备用引擎。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
